class SymbolWin(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="灵犀拼音 符号大全")
        self.set_default_size(760, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)

        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        hbox.set_border_width(8)
        self.add(hbox)

        # 左: 分类列表
        self.cat_store = Gtk.ListStore(str)
        for name in DATA.keys():
            self.cat_store.append([name])
        cat_view = Gtk.TreeView(model=self.cat_store)
        cat_view.set_headers_visible(False)
        renderer = Gtk.CellRendererText()
        col = Gtk.TreeViewColumn("分类", renderer, text=0)
        cat_view.append_column(col)
        cat_view.get_selection().connect("changed", self.on_cat_changed)
        cat_scroll = Gtk.ScrolledWindow()
        cat_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        cat_scroll.set_size_request(140, -1)
        cat_scroll.add(cat_view)
        hbox.pack_start(cat_scroll, False, False, 0)

        # 右: 符号网格 + 底部状态
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hbox.pack_start(right, True, True, 0)

        self.grid_scroll = Gtk.ScrolledWindow()
        self.grid_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        right.pack_start(self.grid_scroll, True, True, 0)

        self.status = Gtk.Label(label="左侧选分类, 点击符号复制", xalign=0)
        self.status.set_ellipsize(Pango.EllipsizeMode.END)
        right.pack_start(self.status, False, False, 0)

        self.grid = None
        # 默认选第一个分类
        first = self.cat_store.get_iter_first()
        if first:
            cat_view.get_selection().select_iter(first)

    def on_cat_changed(self, selection):
        model, it = selection.get_selected()
        if not it:
            return
        cat = model[it][0]
        self.show_category(cat)

    def show_category(self, cat):
        if self.grid:
            self.grid_scroll.remove(self.grid)
            self.grid = None
        syms = DATA.get(cat, [])
        self.grid = Gtk.Grid()
        self.grid.set_row_spacing(2)
        self.grid.set_column_spacing(2)
        cols = 12
        for i, s in enumerate(syms):
            btn = Gtk.Button(label=s)
            btn.set_size_request(48, 44)
            lbl = btn.get_child()
            if lbl:
                lbl.set_ellipsize(Pango.EllipsizeMode.END)
            btn.set_tooltip_text("点击复制: " + s)
            btn.connect("clicked", self.on_sym_clicked, s)
            self.grid.attach(btn, i % cols, i // cols, 1, 1)
        self.grid_scroll.add(self.grid)
        self.grid_scroll.show_all()
        self.status.set_text("%s: %d 个符号, 点击复制" % (cat, len(syms)))

    def on_sym_clicked(self, btn, s):
        ok = copy_clip(s)
        if ok:
            self.status.set_text("已复制到剪贴板: " + s)
        else:
            self.status.set_text("复制失败, 符号: " + s)

win = SymbolWin()
win.show_all()
Gtk.main()
