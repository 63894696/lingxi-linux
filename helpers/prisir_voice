class FloatBall(Gtk.Window):
    """录音中悬浮提示：流式预览 + 可拖动。"""

    def __init__(self, label_provider, on_stop_click=None, on_settings_click=None):
        Gtk.Window.__init__(self, title="灵犀语音")
        self.set_default_size(420, 110)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_accept_focus(False)
        self.set_focus_on_map(False)
        self.set_skip_taskbar_hint(True)
        self.set_decorated(False)
        self._on_stop = on_stop_click
        self._drag = None  # (root_x, root_y, win_x, win_y)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_border_width(10)
        self.add(root)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.pack_start(row, False, False, 0)

        # 顶栏可拖
        drag = Gtk.EventBox()
        drag.set_visible_window(False)
        drag.connect("button-press-event", self._on_press)
        drag.connect("button-release-event", self._on_release)
        drag.connect("motion-notify-event", self._on_motion)
        drag.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.BUTTON_MOTION_MASK
        )
        row.pack_start(drag, True, True, 0)

        drag_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        drag.add(drag_row)
        self.lamp = Gtk.Label(label="●")
        drag_row.pack_start(self.lamp, False, False, 0)
        self.lbl = Gtk.Label(label=label_provider())
        self.lbl.set_xalign(0)
        drag_row.pack_start(self.lbl, True, True, 0)

        if on_settings_click:
            sbtn = Gtk.Button(label="热键")
            sbtn.connect("clicked", lambda *_: on_settings_click())
            row.pack_start(sbtn, False, False, 0)
        if on_stop_click:
            btn = Gtk.Button(label="停止")
            btn.connect("clicked", lambda *_: on_stop_click())
            row.pack_start(btn, False, False, 0)

        # 流式预览正文
        self.partial = Gtk.Label(label="")
        self.partial.set_xalign(0)
        self.partial.set_line_wrap(True)
        self.partial.set_max_width_chars(48)
        self.partial.set_selectable(True)
        root.pack_start(self.partial, True, True, 0)

        cfg = load_cfg()
        fx, fy = cfg.get("float_x"), cfg.get("float_y")
        if isinstance(fx, int) and isinstance(fy, int) and fx >= 0 and fy >= 0:
            self.move(fx, fy)
        else:
            self.set_gravity(Gdk.Gravity.NORTH_EAST)
            self.set_position(Gtk.WindowPosition.NONE)
            GLib.idle_add(self._place_default)

    def _place_default(self):
        try:
            screen = self.get_screen()
            w = screen.get_width() if screen else 1280
            self.resize(420, 110)
            self.move(max(8, w - 440), 48)
        except Exception:
            self.set_position(Gtk.WindowPosition.CENTER)
        return False

    def _on_press(self, _w, event):
        if event.button != 1:
            return False
        # 点在按钮上不拖
        ox, oy = event.get_root_coords()
        wx, wy = self.get_position()
        self._drag = (ox, oy, wx, wy)
        return True

    def _on_release(self, _w, event):
        if self._drag is None:
            return False
        self._drag = None
        try:
            x, y = self.get_position()
            cfg = load_cfg()
            cfg["float_x"], cfg["float_y"] = int(x), int(y)
            save_cfg(cfg)
        except Exception:
            pass
        return True

    def _on_motion(self, _w, event):
        if self._drag is None:
            return False
        ox, oy, wx, wy = self._drag
        rx, ry = event.get_root_coords()
        self.move(int(wx + (rx - ox)), int(wy + (ry - oy)))
        return True

    def set_text(self, text: str, recording: bool = True):
        self.lbl.set_text(text)
        self.lamp.set_markup(
            f'<span foreground="{"#e74c3c" if recording else "#2ecc71"}">●</span>')

    def set_partial(self, text: str):
        """流式预览：讲话过程中更新。"""
        t = (text or "").strip()
        if t:
            self.partial.set_markup(f'<span size="large">{GLib.markup_escape_text(t)}</span>')
        else:
            self.partial.set_text("…")


class SettingsWin(Gtk.Window):
    """热键设置（对齐 Win _open_hotkey_settings）。"""

    def __init__(self, app: "VoiceApp"):
        Gtk.Window.__init__(self, title="语音热键设置")
        self.app = app
        self.set_default_size(360, 220)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", lambda *_: None)

        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        v.set_border_width(16)
        self.add(v)

        cfg = load_cfg()
        cur = cfg.get("hotkey", DEFAULT_HOTKEY)
        v.pack_start(Gtk.Label(label="录音/上屏快捷键（按一下开始，再按一下停止并上屏）",
                               xalign=0), False, False, 0)

        self.btn = Gtk.Button(label=HOTKEY_CHOICES.get(cur, cur))
        self.btn.set_size_request(-1, 48)
        self.btn.connect("clicked", self._start_capture)
        v.pack_start(self.btn, False, False, 0)

        self.hint = Gtk.Label(label="点击上方按钮，然后按下新热键（右 Alt / 左 Alt / F1–F12）",
                              xalign=0)
        self.hint.set_line_wrap(True)
        v.pack_start(self.hint, False, False, 0)

        self.status = Gtk.Label(label="", xalign=0)
        v.pack_start(self.status, False, False, 0)

        row = Gtk.Box(spacing=8)
        close_btn = Gtk.Button(label="关闭")
        close_btn.connect("clicked", lambda *_: self.destroy())
        row.pack_end(close_btn, False, False, 0)
        v.pack_start(row, False, False, 0)

        self._capturing = False
        self.connect("key-press-event", self._on_key)

    def _start_capture(self, *_):
        self._capturing = True
        self.btn.set_label("请按新热键…")
        self.status.set_text("")
        self.set_accept_focus(True)
        self.present()

    def _on_key(self, _w, event):
        if not self._capturing:
            return False
        name = self._event_to_hotkey(event)
        if not name:
            self.status.set_text("仅支持：右/左 Alt 与 F1–F12")
            return True
        cfg = load_cfg()
        cfg["hotkey"] = name
        save_cfg(cfg)
        self.app.reload_hotkey()
        self.btn.set_label(HOTKEY_CHOICES[name])
        self.status.set_text(f"已设置为 {HOTKEY_CHOICES[name]}，立即生效")
        self._capturing = False
        return True

    @staticmethod
    def _event_to_hotkey(event) -> str | None:
        kv = event.keyval
        # Alt_R / Alt_L / Meta variants
        if kv in (Gdk.KEY_Alt_R, Gdk.KEY_Meta_R, Gdk.KEY_ISO_Level3_Shift):
            return "alt_r"
        if kv in (Gdk.KEY_Alt_L, Gdk.KEY_Meta_L):
            return "alt_l"
        for i in range(1, 13):
            if kv == getattr(Gdk, f"KEY_F{i}", None):
                return f"f{i}"
        return None


class VoiceApp:
    """常驻语音服务：热键 + socket IPC + 录音上屏。"""

    # 流式预览：每隔多久对「已录片段」跑一次识别（伪流式；SenseVoice 本身非整句流式模型）
    PARTIAL_INTERVAL = 1.1
    PARTIAL_MIN_SEC = 0.7

    def __init__(self):
        self.asr = SenseVoice()
        self.rec = Recorder()
        self.status = "ready"  # ready | recording | busy
        self.target_wid: str | None = None
        self._busy = False
        self._cfg = load_cfg()
        self._float: FloatBall | None = None
        self._settings: SettingsWin | None = None
        self._quit = False
        self._hotkey = HotkeyWatcher(lambda: self._cfg.get("hotkey", DEFAULT_HOTKEY),
                                     lambda: GLib.idle_add(self.toggle))
        self._server = None
        self._partial_stop = threading.Event()
        self._partial_thread: threading.Thread | None = None
        self._partial_text = ""
        self._partial_busy = False

    def reload_hotkey(self):
        self._cfg = load_cfg()
        # pynput/x11 轮询每次读 get_hotkey()，无需重启 listener
        print(f"[OK] 热键已切换为 {self._cfg.get('hotkey')}", flush=True)

    def hotkey_name(self) -> str:
        k = self._cfg.get("hotkey", DEFAULT_HOTKEY)
        return HOTKEY_CHOICES.get(k, k)

    def start_services(self):
        # 先开 socket，避免「模型加载中菜单无响应」
        self._start_socket()
        _write_pid()
        self._hotkey.start()

        def load_model():
            miss = _deps_missing()
            if miss:
                print("[ERROR] 缺少依赖: " + ", ".join(miss), file=sys.stderr)
                return
            ok, msg = self.asr.load()
            print(f"[{'OK' if ok else 'ERROR'}] {msg}", flush=True)

        threading.Thread(target=load_model, daemon=True).start()

    def _start_socket(self):
        sp = sock_path()
        try:
            if sp.exists():
                sp.unlink()
        except Exception:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(str(sp))
        srv.listen(4)
        srv.settimeout(0.5)
        self._server = srv

        def loop():
            while not self._quit:
                try:
                    conn, _ = srv.accept()
                except socket.timeout:
                    continue
                except Exception:
                    if self._quit:
                        break
                    continue
                try:
                    data = conn.recv(1024).decode("utf-8", "replace").strip().lower()
                    resp = self._handle_cmd(data)
                    conn.sendall((resp + "\n").encode("utf-8"))
                except Exception:
                    pass
                finally:
                    try:
                        conn.close()
                    except Exception:
                        pass

        threading.Thread(target=loop, daemon=True).start()

    def _handle_cmd(self, cmd: str) -> str:
        if cmd in ("ping", "start", "daemon"):
            return f"ok status={self.status} hotkey={self._cfg.get('hotkey')}"
        if cmd == "toggle":
            GLib.idle_add(self.toggle)
            return "ok toggle"
        if cmd == "settings":
            GLib.idle_add(self.open_settings)
            return "ok settings"
        if cmd == "quit":
            GLib.idle_add(self.shutdown)
            return "ok quit"
        if cmd == "status":
            return json.dumps({
                "status": self.status,
                "hotkey": self._cfg.get("hotkey"),
                "hotkey_name": self.hotkey_name(),
            }, ensure_ascii=False)
        return "err unknown"

    def open_settings(self):
        if self._settings:
            try:
                self._settings.present()
                return
            except Exception:
                self._settings = None
        self._settings = SettingsWin(self)
        self._settings.connect("destroy", lambda *_: setattr(self, "_settings", None))
        self._settings.show_all()

    def toggle(self):
        if self._busy:
            return False
        if self.status == "ready":
            self.target_wid = resolve_target_window(get_focus_window())
            try:
                self.rec.start()
            except Exception as e:
                self._toast(f"无法打开麦克风: {e}")
                return False
            self.status = "recording"
            self._partial_text = ""
            self._show_float(f"录音中（流式预览）· 再按 {self.hotkey_name()} 上屏")
            if self._float:
                self._float.set_partial("")
            self._start_partial_loop()
        elif self.status == "recording":
            self._stop_and_commit()
        return False

    def _start_partial_loop(self):
        self._stop_partial_loop()
        self._partial_stop.clear()

        def loop():
            while not self._partial_stop.is_set() and self.status == "recording":
                if self._partial_busy:
                    time.sleep(0.15)
                    continue
                pcm = self.rec.snapshot()
                if len(pcm) < SAMPLE_RATE * self.PARTIAL_MIN_SEC or not _has_speech(pcm):
                    self._partial_stop.wait(self.PARTIAL_INTERVAL)
                    continue
                self._partial_busy = True
                try:
                    text = self.asr.transcribe(pcm)
                except Exception as e:
                    print(f"[WARN] partial: {e}", flush=True)
                    text = ""
                finally:
                    self._partial_busy = False
                if self._partial_stop.is_set() or self.status != "recording":
                    break
                if text and text != self._partial_text:
                    self._partial_text = text

                    def ui(t=text):
                        if self.status == "recording" and self._float:
                            self._float.set_partial(t)
                        return False

                    GLib.idle_add(ui)
                self._partial_stop.wait(self.PARTIAL_INTERVAL)

        self._partial_thread = threading.Thread(target=loop, daemon=True)
        self._partial_thread.start()

    def _stop_partial_loop(self):
        self._partial_stop.set()
        t = self._partial_thread
        self._partial_thread = None
        if t and t.is_alive() and t is not threading.current_thread():
            t.join(timeout=0.2)

    def _show_float(self, text: str):
        if self._float is None:
            self._float = FloatBall(
                lambda: text,
                on_stop_click=lambda: self.toggle(),
                on_settings_click=lambda: self.open_settings(),
            )
            self._float.show_all()
        else:
            self._float.set_text(text, recording=True)
            self._float.show_all()

    def _hide_float(self):
        if self._float:
            try:
                self._float.hide()
            except Exception:
                pass

    def _toast(self, msg: str):
        # 短暂浮窗提示
        self._show_float(msg)
        if self._float:
            self._float.set_text(msg, recording=False)
            self._float.set_partial("")
        GLib.timeout_add(1200, lambda: (self._hide_float(), False)[1])

    def _stop_and_commit(self):
        self._busy = True
        self.status = "busy"
        self._stop_partial_loop()
        if self._float:
            tip = self._partial_text or "识别中…"
            self._float.set_text("定稿识别中…", recording=False)
            if self._partial_text:
                self._float.set_partial(self._partial_text)
        pcm = self.rec.stop()

        def work():
            err = ""
            text = ""
            try:
                if len(pcm) < SAMPLE_RATE * 0.35:
                    err = "录音太短"
                elif not _has_speech(pcm):
                    err = "未检测到语音"
                else:
                    text = self.asr.transcribe(pcm)
                    if not text:
                        # 定稿失败时回退用最后一次流式结果
                        text = self._partial_text
                    if not text:
                        err = "未识别到内容"
            except Exception as e:
                err = str(e)

            def ui():
                self._busy = False
                self.status = "ready"
                self._hide_float()
                if err:
                    self._toast(err)
                    return
                msg = inject_text(text, self.target_wid)
                print(f"[OK] inject {text!r} ({msg})", flush=True)
            GLib.idle_add(ui)

        threading.Thread(target=work, daemon=True).start()

    def shutdown(self):
        self._quit = True
        self._hotkey.stop()
        try:
            if self._server:
                self._server.close()
        except Exception:
            pass
        try:
            sp = sock_path()
            if sp.exists():
                sp.unlink()
        except Exception:
            pass
        _clear_pid()
        Gtk.main_quit()
        return False


def _spawn_daemon() -> None:
    env = _ensure_display_env()
    log_path = Path(env.get("XDG_RUNTIME_DIR") or "/tmp") / "prisir_voice_daemon.log"
    argv = [sys.executable, "-u", str(Path(__file__).resolve()), "--daemon"]
    try:
        logf = open(log_path, "ab", buffering=0)
    except Exception:
        logf = subprocess.DEVNULL
    subprocess.Popen(
        argv, env=env,
        stdout=logf, stderr=logf,
        start_new_session=True,
    )


def _ensure_daemon_and_send(cmd: str) -> int:
    """客户端：若 daemon 未起则拉起，再发命令。"""
    if _daemon_alive():
        r = _sock_send(cmd)
        print(r or "err", flush=True)
        return 0 if r and r.startswith("ok") else 1

    _spawn_daemon()
    # 等 socket 就绪（模型加载可到十余秒）
    for _ in range(200):
        time.sleep(0.1)
        if _daemon_alive():
            break
    else:
        print("err daemon_start_timeout", file=sys.stderr)
        return 1
    # --daemon-only：只拉起，不 toggle
    if cmd in ("", "start", "daemon"):
        print("ok started", flush=True)
        return 0
    r = _sock_send(cmd)
    print(r or "err", flush=True)
    return 0 if r and r.startswith("ok") else 1


def _acquire_daemon_lock():
    """文件锁防双开（systemd + fcitx --start 可能同时拉起）。"""
    import fcntl
    lock_path = _runtime_dir() / "prisir_voice.lock"
    fp = open(lock_path, "w")
    try:
        fcntl.flock(fp.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fp.close()
        return None
    fp.write(str(os.getpid()))
    fp.flush()
    return fp


def run_daemon():
    # 补环境后再进 GTK
    os.environ.update(_ensure_display_env())
    if _daemon_alive():
        print("[INFO] daemon already running", flush=True)
        return 0
    lock_fp = _acquire_daemon_lock()
    if lock_fp is None:
        # 另一实例正在启动；稍等 socket
        for _ in range(50):
            time.sleep(0.1)
            if _daemon_alive():
                print("[INFO] daemon already running", flush=True)
                return 0
        print("[WARN] lock busy but no socket; exiting", flush=True)
        return 1
    app = VoiceApp()
    app.start_services()
    GLib.timeout_add(1000, lambda: not app._quit)
    print(f"[OK] prisir_voice daemon 就绪 · 热键={app.hotkey_name()} · socket={sock_path()}",
          flush=True)
    try:
        Gtk.main()
    finally:
        try:
            lock_fp.close()
        except Exception:
            pass
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(description="灵犀语音听写（Linux）")
    p.add_argument("--daemon", action="store_true", help="前台常驻（热键+IPC）")
    p.add_argument("--start", action="store_true", help="仅确保 daemon 在跑（开机自启用）")
    p.add_argument("--toggle", action="store_true", help="向 daemon 发 toggle（默认）")
    p.add_argument("--settings", action="store_true", help="打开热键设置")
    p.add_argument("--quit", action="store_true", help="退出 daemon")
    p.add_argument("--status", action="store_true", help="查询状态")
    args = p.parse_args(argv)

    if args.daemon:
        return run_daemon()
    if args.start:
        return _ensure_daemon_and_send("start")
    if args.settings:
        return _ensure_daemon_and_send("settings")
    if args.quit:
        r = _sock_send("quit")
        print(r or "not_running", flush=True)
        return 0
    if args.status:
        r = _sock_send("status") or _sock_send("ping")
        print(r or "not_running", flush=True)
        return 0 if r else 1
    # 默认：菜单点击 → toggle（对齐 Win VoiceToggle 事件）
    return _ensure_daemon_and_send("toggle")


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except Exception:
        traceback.print_exc()
        sys.exit(1)
