def _runtime_dir() -> Path:
    d = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/prisir-{os.getuid()}")
    try:
        d.mkdir(parents=True, exist_ok=True)
    except Exception:
        d = Path(f"/tmp/prisir-{os.getuid()}")
        d.mkdir(parents=True, exist_ok=True)
    return d


def sock_path() -> Path:
    return _runtime_dir() / "prisir_voice.sock"


def pid_path() -> Path:
    return _runtime_dir() / "prisir_voice.pid"


def load_cfg() -> dict:
    cfg = {"hotkey": DEFAULT_HOTKEY, "float_x": None, "float_y": None}
    if CFG_PATH.exists():
        try:
            data = json.loads(CFG_PATH.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                cfg.update(data)
        except Exception:
            pass
    if cfg.get("hotkey") not in HOTKEY_CHOICES:
        cfg["hotkey"] = DEFAULT_HOTKEY
    return cfg


def save_cfg(cfg: dict) -> None:
    CFG_DIR.mkdir(parents=True, exist_ok=True)
    CFG_PATH.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def _ensure_display_env(env: dict | None = None) -> dict:
    """补齐 DISPLAY/XAUTHORITY，避免重启后从 fcitx fork 出的进程无 X 权限。"""
    e = dict(env or os.environ)
    if not e.get("DISPLAY"):
        e["DISPLAY"] = ":0"
    if not e.get("XAUTHORITY"):
        home = e.get("HOME") or str(Path.home())
        for cand in (
            Path(home) / ".Xauthority",
            Path("/run/user") / str(os.getuid()) / "gdm" / "Xauthority",
        ):
            if cand.exists():
                e["XAUTHORITY"] = str(cand)
                break
    if not e.get("XDG_RUNTIME_DIR"):
        e["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    return e


