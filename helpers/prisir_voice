    for m in ("numpy", "onnxruntime", "sounddevice"):
        try:
            __import__(m)
        except ImportError:
            miss.append(m)
    return miss


def _hamming(L):
    import numpy as np
    return 0.54 - 0.46 * np.cos(2 * np.pi * np.arange(L) / (L - 1))


def _preemphasis(x, coef=PREEMPH_COEF):
    import numpy as np
    return np.append(x[0], x[1:] - coef * x[:-1]) if coef > 0 else x


def _mel_fb(n_mels, n_fft, sr):
    import numpy as np

    def h2m(f):
        return 2595.0 * np.log10(1.0 + f / 700.0)

    def m2h(m):
        return 700.0 * (10.0 ** (m / 2595.0) - 1.0)

    hz = m2h(np.linspace(h2m(0.0), h2m(sr / 2.0), n_mels + 2))
    bin_f = np.linspace(0, sr / 2, n_fft // 2 + 1)
    fb = np.zeros((n_mels, n_fft // 2 + 1), dtype=np.float32)
    for i in range(n_mels):
        l, c, r = hz[i], hz[i + 1], hz[i + 2]
        for j, f in enumerate(bin_f):
            if l <= f <= c:
                fb[i, j] = (f - l) / (c - l)
            elif c < f <= r:
                fb[i, j] = (r - f) / (r - c)
    return fb


def extract_features(audio, sr=SAMPLE_RATE):
    import numpy as np
    audio = _preemphasis(audio.astype(np.float32), PREEMPH_COEF)
    flen, fshift = int(FRAME_LENGTH_MS * sr / 1000), int(FRAME_SHIFT_MS * sr / 1000)
    win, fb = _hamming(flen), _mel_fb(N_MELS, N_FFT, sr)
    n_frames = max(1, (len(audio) - flen) // fshift + 1)
    if len(audio) < flen:
        audio = np.pad(audio, (0, flen - len(audio)))
    frames = np.lib.stride_tricks.as_strided(
        audio, shape=(n_frames, flen),
        strides=(audio.strides[0] * fshift, audio.strides[0])).copy() * win
    power = np.abs(np.fft.rfft(frames, n=N_FFT, axis=1)) ** 2
    mel_log = np.log10(np.maximum(power @ fb.T, 1e-10))
    mel_log = (mel_log - mel_log.mean(axis=0, keepdims=True)) / (mel_log.std(axis=0, keepdims=True) + 1e-5)
    if n_frames < LFR_M:
        mel_log = np.concatenate([mel_log, np.zeros((LFR_M - n_frames, N_MELS), dtype=np.float32)])
        n_frames = LFR_M
    n_lfr = (n_frames - LFR_M) // LFR_N + 1
    out = np.zeros((n_lfr, N_MELS * LFR_M), dtype=np.float32)
    for i in range(n_lfr):
        out[i] = mel_log[i * LFR_N: i * LFR_N + LFR_M].flatten()
    return out


def greedy_decode(logits, id2tok, blank_id=0):
    preds = logits.argmax(axis=-1)
    result, prev = [], -1
    for p in preds:
        if p != prev and p != blank_id:
            result.append(int(p))
        prev = p
    text = ""
    for idx in result:
        if idx >= len(id2tok):
            continue
        tok = id2tok[idx]
        if tok.startswith("<|") and tok.endswith("|>"):
            continue
        text += " " if tok == "▁" else tok.replace("▁", " ")
    return text.strip()


class SenseVoice:
    def __init__(self):
        self.session = None
        self.id2tok = None
        self._infer_lock = threading.Lock()

    def load(self):
        import onnxruntime as ort
        if not (MODEL_DIR / "model.onnx").exists() or not (MODEL_DIR / "tokens.json").exists():
            return False, f"模型未找到: {MODEL_DIR}"
        try:
            self.session = ort.InferenceSession(
                str(MODEL_DIR / "model.onnx"), providers=["CPUExecutionProvider"])
            toks = json.loads((MODEL_DIR / "tokens.json").read_text(encoding="utf-8"))
            self.id2tok = {i: t for i, t in enumerate(toks)}
            return True, "模型就绪"
        except Exception as e:
            return False, f"模型加载失败: {e}"

    def transcribe(self, pcm, sr=SAMPLE_RATE, language=0, textnorm=14):
        import numpy as np
        if self.session is None:
            return ""
        if pcm.dtype != np.float32:
            pcm = pcm.astype(np.float32) / (32768.0 if pcm.dtype == np.int16 else 1.0)
        feats = extract_features(pcm, sr)
        feed = {
            "speech": feats[np.newaxis, :, :].astype(np.float32),
            "speech_lengths": np.array([feats.shape[0]], dtype=np.int32),
            "language": np.array([language], dtype=np.int32),
            "textnorm": np.array([textnorm], dtype=np.int32),
        }
        # 流式预览与定稿可能并发，ORT session 加锁
        with self._infer_lock:
            return greedy_decode(self.session.run(None, feed)[0][0], self.id2tok)


class Recorder:
    def __init__(self):
        self._frames, self._stream, self.recording = [], None, False
        self._lock = threading.Lock()

    def _cb(self, indata, frames, ti, st):
        if self.recording:
            self._frames.append(indata.copy())

    def start(self):
        import sounddevice as sd
        with self._lock:
            self._stop_locked()
            self._frames, self.recording = [], True
            self._stream = sd.InputStream(
                samplerate=SAMPLE_RATE, channels=1, dtype="int16",
                blocksize=1024, callback=self._cb)
            self._stream.start()

    def _stop_locked(self):
        self.recording = False
        if self._stream:
            try:
                self._stream.stop()
                self._stream.close()
            except Exception:
                pass
            self._stream = None

    def snapshot(self):
        """不停止录音，拷贝当前已录 PCM（供流式预览）。"""
        import numpy as np
        with self._lock:
            if not self._frames:
                return np.array([], dtype=np.float32)
            return np.concatenate(self._frames, axis=0).flatten().astype(np.float32) / 32768.0

    def stop(self):
        import numpy as np
        with self._lock:
            self._stop_locked()
            if not self._frames:
                return np.array([], dtype=np.float32)
            return np.concatenate(self._frames, axis=0).flatten().astype(np.float32) / 32768.0


def _has_xdotool() -> bool:
    return subprocess.call(
        ["which", "xdotool"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0


def get_focus_window() -> str | None:
    if not _has_xdotool():
        return None
    try:
        out = subprocess.check_output(
            ["xdotool", "getwindowfocus"], text=True, timeout=1).strip()
        return out or None
    except Exception:
        return None


def _window_looks_like_ime(wid: str) -> bool:
    if not wid:
        return True
    try:
        name = subprocess.check_output(
            ["xdotool", "getwindowname", wid], text=True, timeout=1).strip().lower()
        cls = subprocess.check_output(
            ["xdotool", "getwindowclassname", wid], text=True, timeout=1).strip().lower()
        blob = name + " " + cls
        return any(k in blob for k in ("fcitx", "kimpanel", "ibus", "灵犀语音"))
    except Exception:
        return False


def resolve_target_window(preferred: str | None = None) -> str | None:
    env = os.environ.get("PRISIR_VOICE_TARGET_WID", "").strip()
    for cand in (preferred, env, get_focus_window()):
        if cand and not _window_looks_like_ime(cand):
            return cand
    return None


def inject_text(text: str, target_wid: str | None) -> str:
    try:
        cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        cb.set_text(text, -1)
        cb.store()
        time.sleep(0.05)
    except Exception as e:
        return f"剪贴板失败: {e}"

    if not _has_xdotool():
        return "已复制（无 xdotool，无法自动上屏）"

    try:
        wid = resolve_target_window(target_wid)
        if wid:
            subprocess.run(
                ["xdotool", "windowactivate", "--sync", wid],
                check=False, timeout=2,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.1)
        else:
            time.sleep(0.12)
        subprocess.run(
            ["xdotool", "key", "--clearmodifiers", "ctrl+v"],
            check=False, timeout=2,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return "已上屏"
    except Exception as e:
        return f"已复制；上屏失败: {e}"


def _has_speech(pcm, threshold=0.01) -> bool:
    import numpy as np
    if len(pcm) == 0:
        return False
    return float(np.sqrt(np.mean(pcm ** 2))) > threshold


# ---------- IPC（对齐 Win 命名事件）----------

def _sock_send(cmd: str, timeout: float = 0.8) -> str | None:
    sp = sock_path()
    if not sp.exists():
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(str(sp))
        s.sendall((cmd.strip() + "\n").encode("utf-8"))
        data = s.recv(4096).decode("utf-8", "replace").strip()
        s.close()
        return data
    except Exception:
        return None


def _daemon_alive() -> bool:
    r = _sock_send("ping")
    return r is not None and r.startswith("ok")


def _write_pid():
    try:
        pid_path().write_text(str(os.getpid()), encoding="utf-8")
    except Exception:
        pass


def _clear_pid():
    try:
        p = pid_path()
        if p.exists():
            p.unlink()
    except Exception:
        pass


# ---------- 全局热键（对齐 Win GetAsyncKeyState 轮询）----------

def _pynput_key(hotkey: str):
    from pynput.keyboard import Key
    mapping = {
        "alt_r": Key.alt_r,
        "alt_l": Key.alt_l,
        "f1": Key.f1, "f2": Key.f2, "f3": Key.f3, "f4": Key.f4,
        "f5": Key.f5, "f6": Key.f6, "f7": Key.f7, "f8": Key.f8,
        "f9": Key.f9, "f10": Key.f10, "f11": Key.f11, "f12": Key.f12,
    }
    return mapping.get(hotkey, Key.alt_r)


class HotkeyWatcher:
    """按下沿触发 callback（toggle）。优先 pynput，否则 X11 轮询。"""

    def __init__(self, get_hotkey, on_trigger):
        self.get_hotkey = get_hotkey  # callable -> str
        self.on_trigger = on_trigger
        self._stop = threading.Event()
        self._listener = None
        self._thread = None
        self._mode = "none"

    def start(self):
        self._stop.clear()
        try:
            import pynput  # noqa: F401
            self._mode = "pynput"
            self._thread = threading.Thread(target=self._run_pynput, daemon=True)
        except ImportError:
            try:
                from Xlib import display  # noqa: F401
                self._mode = "x11"
                self._thread = threading.Thread(target=self._run_x11_poll, daemon=True)
            except ImportError:
                self._mode = "none"
                print("[WARN] 无 pynput/python-xlib，全局热键不可用。pip3 install pynput",
                      file=sys.stderr)
                return
        self._thread.start()
        print(f"[OK] 全局热键监听已启动 ({self._mode})，当前={self.get_hotkey()}", flush=True)

    def stop(self):
        self._stop.set()
        if self._listener is not None:
            try:
                self._listener.stop()
            except Exception:
                pass

    def _fire(self):
        try:
            self.on_trigger()
        except Exception:
            traceback.print_exc()

    def _run_pynput(self):
        from pynput import keyboard
        was_down = False

        def on_press(key):
            nonlocal was_down
            target = _pynput_key(self.get_hotkey())
            if key == target and not was_down:
                was_down = True
                self._fire()

        def on_release(key):
            nonlocal was_down
            target = _pynput_key(self.get_hotkey())
            if key == target:
                was_down = False

        with keyboard.Listener(on_press=on_press, on_release=on_release) as listener:
            self._listener = listener
            while not self._stop.is_set():
                time.sleep(0.05)
            listener.stop()

    def _run_x11_poll(self):
        """无 pynput 时：XQueryKeymap 轮询（对齐 Win GetAsyncKeyState）。"""
        from Xlib import XK, display
        d = display.Display()
        keysym_map = {
            "alt_r": XK.XK_Alt_R, "alt_l": XK.XK_Alt_L,
            "f1": XK.XK_F1, "f2": XK.XK_F2, "f3": XK.XK_F3, "f4": XK.XK_F4,
            "f5": XK.XK_F5, "f6": XK.XK_F6, "f7": XK.XK_F7, "f8": XK.XK_F8,
            "f9": XK.XK_F9, "f10": XK.XK_F10, "f11": XK.XK_F11, "f12": XK.XK_F12,
        }
        was_down = False
        while not self._stop.is_set():
            try:
                ks = keysym_map.get(self.get_hotkey(), XK.XK_Alt_R)
                keycode = d.keysym_to_keycode(ks)
                keymap = d.query_keymap()
                # keymap: 32 bytes, bit per keycode
                down = bool(keymap[keycode // 8] & (1 << (keycode % 8)))
                if down and not was_down:
                    was_down = True
                    self._fire()
                elif not down and was_down:
                    was_down = False
            except Exception:
                pass
            time.sleep(0.03)


