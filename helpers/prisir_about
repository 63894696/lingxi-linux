def _ts():
    import datetime
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def _desktop():
    for d in (os.path.expanduser("~/桌面"), os.path.expanduser("~/Desktop")):
        if os.path.isdir(d):
            return d
    return os.path.expanduser("~")


def _read_tail(path, cap=512 * 1024):
    try:
        with open(path, "rb") as f:
            return f.read()[-cap:]
    except Exception:
        return None


def pack_diag():
    import zipfile, platform
    desk = _desktop()
    zpath = os.path.join(desk, f"lingxi-linux-diag-{_ts()}.zip")
    meta = {
        "ime": "fcitx5-prisir (Linux)",
        "os": platform.platform(),
        "arch": platform.machine(),
        "python": platform.python_version(),
    }
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("meta.json", json.dumps(meta, ensure_ascii=False, indent=2))
        z.writestr("system.txt", "\n".join([
            f"app: fcitx5-prisir Linux",
            f"timestamp: {_ts()}",
            f"os: {platform.platform()}",
            f"kernel: {platform.release()}",
        ]) + "\n")
        for p in ("/tmp/fcitx5-debianuser.log", "/tmp/fcitx5-020-test.log"):
            data = _read_tail(p)
            if data:
                z.writestr("logs/" + os.path.basename(p), data)
    return zpath


class AboutWin(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="灵犀拼音 — 关于")
        self.set_default_size(720, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)

        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        h.set_border_width(10)
        self.add(h)

        self.store = Gtk.ListStore(str)
        for title, _ in SECTIONS:
            self.store.append([title])
        tree = Gtk.TreeView(model=self.store)
        tree.append_column(Gtk.TreeViewColumn("栏目", Gtk.CellRendererText(), text=0))
        tree.get_selection().connect("changed", self.on_sel)
        sw_l = Gtk.ScrolledWindow()
        sw_l.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw_l.set_size_request(140, -1)
        sw_l.add(tree)
        h.pack_start(sw_l, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        h.pack_start(right, True, True, 0)
        self.body = Gtk.TextView()
        self.body.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.body.set_editable(False)
        self.body.set_cursor_visible(False)
        self.buf = self.body.get_buffer()
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        sw.add(self.body)
        right.pack_start(sw, True, True, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        right.pack_start(row, False, False, 0)
        b1 = Gtk.Button(label="反馈问题（打包诊断）")
        b1.connect("clicked", self.on_feedback)
        row.pack_end(b1, False, False, 0)
        b2 = Gtk.Button(label="打开官网")
        b2.connect("clicked", lambda *_: webbrowser.open(WEBSITE_URL))
        row.pack_end(b2, False, False, 0)

        tree.get_selection().select_path(Gtk.TreePath.new_first())

    def on_sel(self, sel):
        model, it = sel.get_selected()
        if not it:
            return
        idx = model.get_path(it).get_indices()[0]
        self.buf.set_text(SECTIONS[idx][1])

    def on_feedback(self, *_):
        try:
            z = pack_diag()
            dlg = Gtk.MessageDialog(
                transient_for=self, message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                text=f"诊断包已保存：\n{z}\n\n将打开论坛，请上传该 zip。")
            dlg.run()
            dlg.destroy()
            webbrowser.open(FORUM_URL)
        except Exception as e:
            dlg = Gtk.MessageDialog(
                transient_for=self, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK, text=str(e))
            dlg.run()
            dlg.destroy()


