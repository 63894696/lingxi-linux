[Desktop Entry]
Type=Application
Name=灵犀语音听写
Comment=Lingxi voice dictation daemon (SenseVoice)
Exec=/usr/lib/fcitx5/prisir/prisir_voice --start
TryExec=/usr/lib/fcitx5/prisir/prisir_voice
Icon=audio-input-microphone
Terminal=false
Categories=Utility;Accessibility;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
StartupNotify=false
